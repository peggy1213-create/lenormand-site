# Production build-time env. NEXT_PUBLIC_* values are inlined into the client
# bundle at build time, so this must be set wherever `next build` runs.
#
# The Turnstile SITE key is public (it's exposed in the browser), so it's safe
# to commit here. The matching SECRET key lives only in Worker secrets
# (TURNSTILE_SECRET_KEY), never in the repo.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFAtf9eioiYoCjAw
