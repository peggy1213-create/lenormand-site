{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lenormand-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets"
  },
  // Workers AI, used for the free reading tier in
  // src/app/api/reading/free/route.ts.
  "ai": {
    "binding": "AI"
  },
  // D1 holds the free-tier usage counters (per anonymous visitor, per IP, per
  // signed-in user, and a global daily total). This is the DEV database — run
  // `npx wrangler d1 create lenormand-free-dev`, paste the returned id below,
  // then apply migrations/ (see README). Production uses its own database.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lenormand-free-dev",
      "database_id": "REPLACE_WITH_DEV_D1_DATABASE_ID"
    }
  ],
  // Non-secret tuning. TURNSTILE_SECRET_KEY and ANON_HASH_SALT are secrets —
  // set them with `npx wrangler secret put`, never here. The Turnstile *site*
  // key is public and read at build time from NEXT_PUBLIC_TURNSTILE_SITE_KEY.
  "vars": {
    "FREE_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "FREE_USER_DAILY_CAP": "2",
    "FREE_AUTH_DAILY_CAP": "3",
    "FREE_IP_DAILY_CAP": "8",
    "FREE_GLOBAL_DAILY_CAP": "200"
  }
}
